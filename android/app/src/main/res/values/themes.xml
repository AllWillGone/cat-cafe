<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CatCafe" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cat_primary</item>
        <item name="colorPrimaryVariant">@color/cat_primary_dark</item>
        <item name="colorSecondary">@color/cat_accent</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/cat_text</item>
        <item name="colorOutline">@color/cat_border</item>
        <item name="android:windowBackground">@color/cat_surface</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="materialButtonStyle">@style/Widget.CatCafe.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.CatCafe.Button.Outlined</item>
    </style>

    <style name="Theme.CatCafe" parent="Base.Theme.CatCafe" />

    <style name="ShapeAppearance.CatCafe.Circle" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.CatCafe.Button" parent="">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Widget.CatCafe.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.CatCafe.Button</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <style name="Widget.CatCafe.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.CatCafe.Button</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">40dp</item>
    </style>
</resources>
